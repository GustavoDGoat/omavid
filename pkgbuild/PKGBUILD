# Maintainer: David Heinemeier Hansson <david@hey.com>

pkgname=omavid
pkgver=0.3.0
pkgrel=1
pkgdesc='Dead-simple video trimmer and merger built with Qt Quick and ffmpeg'
arch=('x86_64')
url='https://github.com/GustavoDGoat/omavid'
license=('MIT')
install='omavid.install'
depends=('ffmpeg' 'qt6-base' 'qt6-declarative' 'qt6-multimedia' 'xdg-desktop-portal')
makedepends=('gcc' 'make' 'qt6-base' 'qt6-declarative' 'qt6-multimedia')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  /usr/bin/install -Dm755 build/omavid "$pkgdir/usr/bin/omavid"
  /usr/bin/install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  /usr/bin/install -Dm644 "$startdir/omavid.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omavid.svg"
  /usr/bin/install -Dm644 "$startdir/omavid.desktop" "$pkgdir/usr/share/applications/omavid.desktop"
}
